<% include component/header.ejs %>
<% include component/navbar.ejs %>
<script>
var sSell = "買入";
var sBuy = "沽出";
var sFail = "交易失敗";
var sError = "錯誤";

var algo = "<%= algo %>";
var ui = new Array();
var html = null;

$(document).ready(function() {
  var command = '{"type":"list_orders"}';
  initUI();
  sendWebsocket(command);
  initWebsocket(render);
});

function render(res) {
  initUI();
  var data = JSON.parse(res);
  // 有交易， 用一个Module
  if (data.action=='list_orders' && "ordres" in data && data.ordres.length>0 && algo==data.ordres[0].key) {
    var orders = data.ordres;
    for (var i in orders) {
      var code = orders[i].code;
      var key = orders[i].key;
      var price = formatNumber(orders[i].match_price);
      var quantity = formatNumber(orders[i].match_quantity);
      var status = orders[i].status.replace("order_status::", "");
      var reject_reason = orders[i].reject_reason;
      var _tm = orders[i].transaction_tm;
      var tm = _tm.substring(0, 4)+'-'+_tm.substring(4, 6)+'-'+_tm.substring(6, 8)+' '+
                _tm.substring(8, 10)+':'+_tm.substring(10, 12)+':'+_tm.substring(12, 14);
      
      // 操作
      if (orders[i].side.indexOf('sell')>=0) {
        var side = sSell;
        var css_side = 'text-danger';
        var total = -(price*quantity);
      }else{
        var side = sBuy;
        var css_side = 'text-success';
        var total = +(price*quantity);
      }
      
      // 成交額
      if(status=='filled' && total>=0) {
        var total = '+'+formatPrice(total);
        var css_total = 'text-success';
      }
      else if(status=='filled' && total<0) {
        var total = formatPrice(total);
        var css_total = 'text-danger';
      }
      else if(status=='rejected') {
        var total = sFail;
        var css_total = 'text-info';
      }
      else {
        var total = sError;
        var css_total = 'text-warning';
      }
      
      // 狀態
      if(status.indexOf('filled')>=0)
        var rejectReason = '';
      else
        var rejectReason = ', '+reject_reason;
        
      
      // 渲染
      html += 
      '<tr>'+
      '<td>'+code+'</td>'+
      '<td class="'+css_side+'"><strong>'+side+'</strong></td>'+
      '<td>'+price+'</td>'+
      '<td>'+quantity+'</td>'+
      '<td>'+status+''+rejectReason+'</td>'+
      '<td>'+tm+'</td>'+
      '<td class="'+css_total+'"><strong>'+total+'</strong></td>'+
      '</tr>';
    }
    ui.tbody.html(html);
  }
}

function initUI() {
  ui.container = $('#algo');
  ui.tbody = $('#algo table tbody');
}

</script>

<div id="algo" class="container">

<table class="table table-sm table-striped table-light">
  <col width="10%">
  <col width="10%">
  <col width="10%">
  <col width="10%">
  <col width="25%">
  <col width="20%">
  <col width="15%">
  <thead>
    <tr>
      <th scope="col">權證</th>
      <th scope="col">操作</th>
      <th scope="col">成交價</th>
      <th scope="col">單位</th>
      <th scope="col">狀態</th>
      <th scope="col">時間</th>
      <th scope="col">成交額</th>
    </tr>
  </thead>
  <tbody>
  </tbody>
<table>

</div>
<% include component/footer.ejs %>